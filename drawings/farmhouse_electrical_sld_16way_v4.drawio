      <mxCell id="lbl_box4_container" value="&lt;b&gt;Box 4: Container Sub-DB&lt;/b&gt;" style="html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="268.0" y="1130.0" width="740.0" height="30" as="geometry" /></mxCell><mxCell id="lbl_box5_ne" value="Box 5: North-East Sub-DB (3x 1P 25A incomer + 4x 1P = 7 Mod @17.5mm)" style="html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1425.0" y="1130.0" width="740.0" height="30" as="geometry" /></mxCell><mxCell id="lbl_box6_amphi" value="Box 6: Amphi Sub-DB (2x 1P 25A incomer + 20A 1P + 16A 1P+N RCBO = 5 Mod)" style="html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2482.0" y="500.0" width="430" height="30" as="geometry" /></mxCell><mxCell id="inv_mcb_6a" value="&lt;b&gt;10A 1P C&lt;/b&gt;&lt;br&gt;Inverter" style="verticalLabelPosition=right;dashed=0;shadow=0;html=1;align=left;verticalAlign=middle;shape=mxgraph.cabinets.cb_1p;labelPerimeter=1;points=[[0.5,0,0,0,0],[0.5,1,0,0,0]];fontSize=9;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="920" y="1250" width="9" height="50" as="geometry" /></mxCell><mxCell id="inv_edge_from_rccb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="box4_mcb_R" target="inv_mcb_6a" value="1.5mm²Cu"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="mc_main_63a_4p" parent="1" value="&lt;b&gt;63A 4P B&lt;/b&gt;&lt;br&gt;Main" style="verticalLabelPosition=bottom;dashed=0;shadow=0;html=1;align=center;verticalAlign=top;shape=mxgraph.cabinets.mccb_25_63a_4p;labelPerimeter=1;points=[[0.147,0,0,0,0],[0.147,1,0,0,0],[0.375,1,0,0,0],[0.4,0,0,0,0],[0.6345,0,0,0,0],[0.6345,1,0,0,0],[0.875,0,0,0,0],[0.875,1,0,0,0]];fontSize=9;labelBackgroundColor=#FFFFFF;" vertex="1"><mxGeometry x="770" y="380" width="80" height="90" as="geometry" /></mxCell><mxCell id="box4_mcb_R" parent="1" style="verticalLabelPosition=right;dashed=0;shadow=0;html=1;align=left;verticalAlign=middle;shape=mxgraph.cabinets.cb_1p;labelPerimeter=1;points=[[0.5,0,0,0,0],[0.5,1,0,0,0]];fontSize=9;labelBackgroundColor=#FFFFFF;" value="&lt;b&gt;32A 1P B&lt;/b&gt;&lt;br&gt;Incomer R" vertex="1"><mxGeometry x="280" y="1240" width="9" height="50" as="geometry" /></mxCell><mxCell id="box4_mcb_Y" parent="1" style="verticalLabelPosition=right;dashed=0;shadow=0;html=1;align=left;verticalAlign=middle;shape=mxgraph.cabinets.cb_1p;labelPerimeter=1;points=[[0.5,0,0,0,0],[0.5,1,0,0,0]];fontSize=9;labelBackgroundColor=#FFFFFF;" value="&lt;b&gt;32A 1P B&lt;/b&gt;&lt;br&gt;Incomer Y" vertex="1"><mxGeometry x="350" y="1240" width="9" height="50" as="geometry" /></mxCell><mxCell id="box4_mcb_B" parent="1" style="verticalLabelPosition=right;dashed=0;shadow=0;html=1;align=left;verticalAlign=middle;shape=mxgraph.cabinets.cb_1p;labelPerimeter=1;points=[[0.5,0,0,0,0],[0.5,1,0,0,0]];fontSize=9;labelBackgroundColor=#FFFFFF;" value="&lt;b&gt;32A 1P B&lt;/b&gt;&lt;br&gt;Incomer B" vertex="1"><mxGeometry x="420" y="1240" width="9" height="50" as="geometry" /></mxCell><mxCell id="box4_incomer_note" parent="1" style="html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;" value="Box 4 incomer = 3 x 1P 32 A B-curve (one per phase). RCCB optional / not used." vertex="1"><mxGeometry x="257.5" y="1570" width="740" height="45" as="geometry" /></mxCell><mxCell id="shared_geyser_note" parent="1" style="html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;" value="Shared geysers: one 2 kW for Rooms 1&amp;2, one 2 kW for Rooms 3&amp;4 — use a dedicated 16A 1P B-curve circuit per geyser, NOT via the room AC MCB (room AC + geyser would be ~19A on a 20A MCB)." vertex="1"><mxGeometry x="257.5" y="1630" width="740" height="45" as="geometry" /></mxCell><mxCell id="future_container_note" parent="1" style="html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;" value="Future South/West container circuits: run a separate feeder from the Main DB. Do not tee off Rooms 1–4: the 10 sqmm Al feeder is already ~30A worst phase with 4 rooms + stage." vertex="1"><mxGeometry x="257.5" y="1690" width="740" height="45" as="geometry" /></mxCell><mxCell id="sched_box1_3" value="&lt;b&gt;Schedule A — Box 1 (optional) / Box 2 / Box 3&lt;/b&gt;&lt;br&gt;63A 4P B — Main incomer in Box 2 (phase + neutral through breaker)&lt;br&gt;32A 3P B — Container feeder (10 sqmm Al, derated ~28–32A)&lt;br&gt;3x 25A 1P B — Outdoor feeder R/Y/B; 32A 1P B — Shed + AC feeder&lt;br&gt;2x 25A 1P B — North-East feeder Y/B; 10A 1P C — SE / E street lights&lt;br&gt;10A 1P C — Pond pump; 16A 1P C — 1.5 HP submersible pump&lt;br&gt;Box 1: changeover + OV/UV + SPD — OPTIONAL / NOT INSTALLED&lt;br&gt;Phase plan: R = Shed + AC / Submersible pump / SE St; Y = Amphi/street lights + South container; B = pond/pool + West container AC." style="text;html=1;strokeColor=#B85450;fillColor=#FFF6F4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="258" y="1760" width="800" height="150" as="geometry" /></mxCell><mxCell id="sched_box4" value="&lt;b&gt;Schedule B — Box 4 (Container Sub-DB)&lt;/b&gt;&lt;br&gt;3x 32A 1P B — Incomer R / Y / B (one per phase)&lt;br&gt;20A 1P B — Room 1 (R), Room 2 (Y), Room 3 (B), Room 4 (R)&lt;br&gt;20A 1P B — Stage Left, Stage Right&lt;br&gt;10A 1P C — Street lights South-West&lt;br&gt;10A 1P C — Inverter line (lights + fans)&lt;br&gt;Shared 2kW geysers: one for Rooms 1&amp;amp;2, one for Rooms 3&amp;amp;4 — dedicated 16A 1P B circuit each" style="text;html=1;strokeColor=#B85450;fillColor=#FFF6F4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="1760" width="800" height="150" as="geometry" /></mxCell><mxCell id="sched_box5_6" value="&lt;b&gt;Schedule C — Box 5 / Box 6&lt;/b&gt;&lt;br&gt;3x 25A 1P B — Outdoor distribution&lt;br&gt;10A 1P C — North St / Main St / Gate lights (8x 36W each)&lt;br&gt;16A 1P C — Submersible pump, 1.5 HP (fixed-speed → C)&lt;br&gt;2x 25A 1P B — Amphi + pool feeder; 20A 1P B — Amphi&lt;br&gt;16A 1P+N RCBO 30mA C — Swimming pool pump&lt;br&gt;Future containers: separate feeder from Main DB, not a tee off Rooms 1–4" style="text;html=1;strokeColor=#B85450;fillColor=#FFF6F4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="1900" y="1760" width="800" height="150" as="geometry" /></mxCell><mxCell id="box1_spd_opt" value="&lt;b&gt;Type-2 SPD&lt;/b&gt;&lt;br&gt;OPTIONAL / NOT INSTALLED" style="rounded=0;dashed=1;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;align=center;verticalAlign=middle;fontSize=9;" vertex="1" parent="1"><mxGeometry x="310" y="190" width="150" height="45" as="geometry" /></mxCell><mxCell id="main_neutral_in" value="N · 16mm²Al" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;defaultLabelBackgroundColor=page;strokeColor=#B45309;exitX=0;exitY=0.5;entryX=0.875;entryY=1" edge="1" parent="1" source="bNfMxfX9K-qKM2XH7_Ha-49" target="mc_main_63a_4p"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="main_neutral_out_serplex" value="N · 16mm²Cu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;defaultLabelBackgroundColor=page;strokeColor=#B45309;;exitX=0.875;exitY=0;;entryX=0.5;entryY=0" edge="1" parent="1" source="mc_main_63a_4p" target="serp_N_1"><mxG